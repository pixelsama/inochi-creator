+    // A pixel can contain several cage regions. Test the actual point against
+    // source triangles and interpolate locally; never extrapolate from a pixel
+    // corner's triangle or multiply a cancellation-prone global affine matrix.
+    bool mapInsideTriangle(vec2 point, size_t index, out vec2 mapped) {
+        auto ai = data.indices[index * 3];
+        auto bi = data.indices[index * 3 + 1];
+        auto ci = data.indices[index * 3 + 2];
+        auto a = data.vertices[ai], b = data.vertices[bi], c = data.vertices[ci];
+        double bx = cast(double)b.x - a.x, by = cast(double)b.y - a.y;
+        double cx = cast(double)c.x - a.x, cy = cast(double)c.y - a.y;
+        double px = cast(double)point.x - a.x, py = cast(double)point.y - a.y;
+        double determinant = bx * cy - by * cx;
+        mapped = point;
+        if (abs(determinant) < 1e-15) return false;
+        double v = (px * cy - py * cx) / determinant;
+        double w = (bx * py - by * px) / determinant;
+        double u = 1.0 - v - w;
+        if (u < -2e-6 || v < -2e-6 || w < -2e-6) return false;
+        auto qa = transformedVertices[ai], qb = transformedVertices[bi], qc = transformedVertices[ci];
+        mapped = vec2(cast(float)(u * qa.x + v * qb.x + w * qc.x),
+                      cast(float)(u * qa.y + v * qb.y + w * qc.y));
+        return true;
     }
 
