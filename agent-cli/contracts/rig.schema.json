{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inochi Agent Rig v1",
  "description": "Structural contract. rig-validate checks dimensions, finite numbers, references, ranges and topology against the model.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "meshes": {"type": "array", "items": {"$ref": "#/$defs/meshRequest"}},
    "masks": {"type": "array", "items": {"$ref": "#/$defs/mask"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "physics": {"type": "array", "items": {"$ref": "#/$defs/physics"}}
  },
  "$defs": {
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["keys"],
      "properties": {
        "min": {"type": "number"}, "max": {"type": "number"}, "default": {"type": "number"},
        "keys": {"type": "array", "minItems": 2, "items": {"type": "number"}}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name", "bindings"],
      "oneOf": [
        {"required": ["keys"], "not": {"required": ["axes"]}},
        {"required": ["axes"], "not": {"anyOf": [{"required": ["keys"]}, {"required": ["min"]}, {"required": ["max"]}, {"required": ["default"]}]}}
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "min": {"type": "number"}, "max": {"type": "number"}, "default": {"type": "number"},
        "keys": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "axes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/axis"}},
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "property", "values"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "property": {"enum": ["transform.t.x", "transform.t.y", "transform.t.z", "transform.r.x", "transform.r.y", "transform.r.z", "transform.s.x", "transform.s.y", "opacity", "deform"]},
        "interpolation": {"enum": ["Linear", "Nearest", "Cubic"]},
        "values": {"type": "array", "minItems": 2, "description": "Scalar values[x]; vector values[x][y], X-major. Cells are numeric for transforms/opacity, or a deformation object/null for deform."}
      }
    },
    "deformation": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["offsets"], "properties": {"offsets": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/pair"}}}},
        {"type": "object", "additionalProperties": false, "required": ["profiles"], "properties": {"profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}}}
      ]
    },
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["translate", "archX", "archY", "shearX", "shearY", "tipX", "tipY", "scaleX", "scaleY", "pinchX", "pinchY", "curveMorph"]},
        "amount": {"type": "number"}, "x": {"type": "number"}, "y": {"type": "number"},
        "widthScale": {"type": "number"}, "thicknessScale": {"type": "number"},
        "offsetY": {"type": "number"}, "curvatureY": {"type": "number"}, "slopeY": {"type": "number"},
        "anchorLeft": {"type": "number", "minimum": 0, "maximum": 1},
        "anchorRight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "mesh": {
      "type": "object", "additionalProperties": false, "required": ["verts", "uvs", "indices", "origin"],
      "properties": {
        "verts": {"type": "array", "minItems": 6, "items": {"type": "number"}},
        "uvs": {"type": "array", "minItems": 6, "items": {"type": "number"}},
        "indices": {"type": "array", "minItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "origin": {"$ref": "#/$defs/pair"},
        "grid_axes": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
      }
    },
    "meshRequest": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "oneOf": [
        {"required": ["mesh"], "not": {"anyOf": [{"required": ["rows"]}, {"required": ["columns"]}]}},
        {"required": ["rows", "columns"], "not": {"required": ["mesh"]}}
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "mesh": {"$ref": "#/$defs/mesh"},
        "columns": {"type": "integer", "minimum": 2, "maximum": 65536},
        "rows": {"type": "integer", "minimum": 2, "maximum": 65536}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false, "required": ["name", "paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "pivot": {"$ref": "#/$defs/pair"}, "zsort": {"type": "number"}
      }
    },
    "mask": {
      "type": "object", "additionalProperties": false, "required": ["target", "source", "mode"],
      "properties": {
        "target": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1},
        "mode": {"enum": ["mask", "dodge_mask", "dodge", "Mask", "DodgeMask"]}
      }
    },
    "physics": {
      "type": "object", "additionalProperties": false, "required": ["name", "parent", "parameter", "model_type", "map_mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "parent": {"type": "string", "minLength": 1}, "parameter": {"type": "string", "minLength": 1},
        "model_type": {"enum": ["Pendulum", "SpringPendulum", "pendulum", "spring_pendulum"]},
        "map_mode": {"enum": ["AngleLength", "XY", "LengthAngle", "YX", "angle_length", "xy", "length_angle", "yx"]},
        "output_scale": {"$ref": "#/$defs/pair"}, "gravity": {"type": "number"},
        "length": {"type": "number", "exclusiveMinimum": 0}, "frequency": {"type": "number", "exclusiveMinimum": 0},
        "angle_damping": {"type": "number", "minimum": 0, "maximum": 1},
        "length_damping": {"type": "number", "minimum": 0, "maximum": 1}, "local_only": {"type": "boolean"}
      }
    }
  }
}
