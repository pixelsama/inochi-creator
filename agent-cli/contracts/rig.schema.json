{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inochi Agent Rig v1",
  "description": "Structural contract. rig-validate checks dimensions, finite numbers, references, ranges and topology against the model. Sections apply in order: groups, parts, masks, meshes, parameters, physics, automation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/partProperties"
      }
    },
    "masks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mask"
      }
    },
    "meshes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meshRequest"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "physics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physics"
      }
    },
    "automation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/automation"
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "keys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bindings"
      ],
      "oneOf": [
        {
          "required": [
            "keys"
          ],
          "not": {
            "required": [
              "axes"
            ]
          }
        },
        {
          "required": [
            "axes"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "keys"
                ]
              },
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              },
              {
                "required": [
                  "default"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "keys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "axes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/axis"
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "property",
        "values"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "enum": [
            "transform.t.x",
            "transform.t.y",
            "transform.t.z",
            "transform.r.x",
            "transform.r.y",
            "transform.r.z",
            "transform.s.x",
            "transform.s.y",
            "zSort",
            "opacity",
            "tint.r",
            "tint.g",
            "tint.b",
            "screenTint.r",
            "screenTint.g",
            "screenTint.b",
            "deform"
          ],
          "description": "transform.* and zSort: any node (zSort is added; larger draws further back). opacity/tint/screenTint: Part or Composite; tint multiplies (>=0), screenTint adds ([-1,1]), results clamp to [0,1]. deform: Part or MeshGroup."
        },
        "interpolation": {
          "enum": [
            "Linear",
            "Nearest",
            "Cubic"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "description": "Scalar values[x]; vector values[x][y], X-major. Cells are numeric, or a deformation object/null for deform."
        }
      }
    },
    "deformation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offsets"
          ],
          "properties": {
            "offsets": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/pair"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profiles"
          ],
          "properties": {
            "profiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/profile"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "translate",
            "archX",
            "archY",
            "shearX",
            "shearY",
            "tipX",
            "tipY",
            "scaleX",
            "scaleY",
            "pinchX",
            "pinchY",
            "curveMorph"
          ]
        },
        "amount": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "widthScale": {
          "type": "number"
        },
        "thicknessScale": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        },
        "curvatureY": {
          "type": "number"
        },
        "slopeY": {
          "type": "number"
        },
        "anchorLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchorRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verts",
        "uvs",
        "indices",
        "origin"
      ],
      "properties": {
        "verts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "number"
          }
        },
        "uvs": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "number"
          }
        },
        "indices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "origin": {
          "$ref": "#/$defs/pair"
        },
        "grid_axes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "meshRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "oneOf": [
        {
          "required": [
            "mesh"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rows"
                ]
              },
              {
                "required": [
                  "columns"
                ]
              },
              {
                "required": [
                  "auto"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "rows",
            "columns"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mesh"
                ]
              },
              {
                "required": [
                  "auto"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "auto"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mesh"
                ]
              },
              {
                "required": [
                  "rows"
                ]
              },
              {
                "required": [
                  "columns"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mesh": {
          "$ref": "#/$defs/mesh"
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 65536
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 65536
        },
        "auto": {
          "$ref": "#/$defs/autoMesh"
        }
      },
      "description": "Grid and custom meshes target Parts or MeshGroups; auto meshes follow a Part's texture alpha."
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "paths"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pivot": {
          "$ref": "#/$defs/pair"
        },
        "zsort": {
          "type": "number"
        },
        "type": {
          "enum": [
            "Node",
            "MeshGroup",
            "Composite"
          ]
        },
        "mesh": {
          "$ref": "#/$defs/mesh"
        },
        "columns": {
          "type": "integer",
          "minimum": 2
        },
        "rows": {
          "type": "integer",
          "minimum": 2
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "description": "MeshGroup grid padding in pixels (default 8)."
        },
        "dynamic": {
          "type": "boolean",
          "description": "MeshGroup dynamic_deformation (default false)."
        },
        "blend_mode": {
          "$ref": "#/$defs/blendMode"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tint": {
          "$ref": "#/$defs/color"
        },
        "screen_tint": {
          "$ref": "#/$defs/color"
        },
        "propagate_meshgroup": {
          "type": "boolean"
        }
      },
      "description": "Creates a node at the model root and moves paths into it. MeshGroup deforms its descendants through a cage mesh (grid over children's rest bounds unless mesh is given). Composite renders its Parts offscreen and blends the result once; composites cannot nest."
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "source",
        "mode"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "mask",
            "dodge_mask",
            "dodge",
            "Mask",
            "DodgeMask"
          ]
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parent",
        "parameter",
        "model_type",
        "map_mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "model_type": {
          "enum": [
            "Pendulum",
            "SpringPendulum",
            "pendulum",
            "spring_pendulum"
          ]
        },
        "map_mode": {
          "enum": [
            "AngleLength",
            "XY",
            "LengthAngle",
            "YX",
            "angle_length",
            "xy",
            "length_angle",
            "yx"
          ]
        },
        "output_scale": {
          "$ref": "#/$defs/pair"
        },
        "gravity": {
          "type": "number"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequency": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_damping": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "length_damping": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "local_only": {
          "type": "boolean"
        }
      }
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "blendMode": {
      "enum": [
        "Normal",
        "Multiply",
        "Screen",
        "Overlay",
        "Darken",
        "Lighten",
        "ColorDodge",
        "LinearDodge",
        "AddGlow",
        "ColorBurn",
        "HardLight",
        "SoftLight",
        "Difference",
        "Exclusion",
        "Subtract",
        "Inverse",
        "DestinationIn",
        "ClipToLower",
        "SliceFromLower"
      ],
      "description": "macOS OpenGL has no advanced blending: Overlay, Darken, ColorBurn, HardLight, SoftLight and Difference render as Normal there."
    },
    "autoMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spacing": {
          "type": "number",
          "minimum": 2,
          "description": "Interior vertex spacing in texture pixels (default 16); boundary spacing is half."
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 256,
          "description": "Pixels beyond the alpha footprint (default 2)."
        },
        "alpha_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Minimum premultiplied alpha that must be covered (default 8)."
        },
        "max_vertices": {
          "type": "integer",
          "minimum": 3,
          "maximum": 65536,
          "description": "Default 4000."
        }
      }
    },
    "partProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "minProperties": 2,
      "description": "Static appearance of a Part or Composite.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blend_mode": {
          "$ref": "#/$defs/blendMode"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tint": {
          "$ref": "#/$defs/color"
        },
        "screen_tint": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bindings"
      ],
      "description": "Sine automation added to parameters at runtime; replaces an existing automation of the same name.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "sine"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Radians per second (default 1)."
        },
        "wave": {
          "enum": [
            "sin",
            "cos"
          ]
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "range"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              },
              "axis": {
                "enum": [
                  0,
                  1
                ]
              },
              "range": {
                "$ref": "#/$defs/pair"
              }
            }
          }
        }
      }
    }
  }
}
